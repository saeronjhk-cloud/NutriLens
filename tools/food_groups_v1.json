{
  "version": "v1",
  "updated": "2026-07-03",
  "note": "주간 리포트 top_food_groups용 음식명→음식군 매핑. 규칙은 위→아래 순서로 첫 매치 승리(순서가 곧 우선순위). 매칭은 공백 제거 사본 기준. 원본=IP 폴더, 엔진 저장소에는 tools/food_groups_v1.json 복사본.",
  "match_field": "name_ko",
  "default_group": "기타",
  "rules": [
    { "group": "국·탕·찌개", "suffix": ["국", "탕", "찌개", "전골"], "contains": ["스프", "수프"] },
    { "group": "면류", "suffix": ["면", "국수", "우동", "라면"], "contains": ["파스타", "스파게티", "쌀국수", "짜장", "짬뽕"] },
    { "group": "밥·죽", "suffix": ["밥", "죽"], "contains": ["리조또", "덮밥", "초밥"] },
    { "group": "빵·샌드위치", "contains": ["빵", "토스트", "샌드위치", "베이글", "크루아상", "버거", "피자"] },
    { "group": "떡·분식", "contains": ["떡볶이", "순대", "어묵", "핫도그", "만두"] },
    { "group": "볶음류", "suffix": ["볶음"], "contains": ["볶음"] },
    { "group": "찜·조림", "suffix": ["찜", "조림"] },
    { "group": "튀김류", "suffix": ["튀김", "까스", "가스"], "contains": ["치킨", "프라이드", "탕수육", "돈가스", "돈까스"] },
    { "group": "구이류", "suffix": ["구이"], "contains": ["스테이크", "삼겹살", "불고기", "갈비"] },
    { "group": "전·부침", "suffix": ["전", "부침개"], "contains": ["부침"] },
    { "group": "무침·나물", "suffix": ["무침", "나물"], "contains": ["나물"] },
    { "group": "샐러드·생채소", "contains": ["샐러드", "쌈", "생채"] },
    { "group": "김치·절임", "contains": ["김치", "깍두기", "장아찌", "피클", "단무지"] },
    { "group": "계란", "contains": ["계란", "달걀", "오믈렛", "에그"] },
    { "group": "두부·콩", "contains": ["두부", "콩자반", "낫토", "청국장"] },
    { "group": "생선·해산물", "suffix": ["회"], "contains": ["생선", "고등어", "연어", "참치", "새우", "오징어", "조개", "굴비", "갈치"] },
    { "group": "육류", "contains": ["고기", "닭", "돼지", "소고기", "오리", "햄", "소시지", "베이컨", "제육", "수육", "족발", "보쌈"] },
    { "group": "과일", "contains": ["사과", "바나나", "딸기", "포도", "수박", "귤", "오렌지", "키위", "복숭아", "과일", "블루베리", "토마토"] },
    { "group": "유제품", "contains": ["우유", "요거트", "요구르트", "치즈"] },
    { "group": "음료", "suffix": ["차", "라떼", "주스"], "contains": ["커피", "아메리카노", "콜라", "사이다", "스무디", "에이드", "음료"] },
    { "group": "간식·디저트", "suffix": ["떡"], "contains": ["과자", "쿠키", "케이크", "초콜릿", "아이스크림", "빙수", "젤리", "사탕", "마카롱"] }
  ]
}
